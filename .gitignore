# LifeReceipt — Git Ignore Policy
# Strictly prevents accidental leakage of credentials, tokens, build outputs, and user data.

# Environment and Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production Builds
dist/
frontend/dist/
build/

# Uploaded User Documents & Invoices (Preserve .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# System & OS Files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test and Coverage Artifacts
coverage/
.nyc_output/
