# ==============================================================================
# LIFERECEIPT FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.production before running `npm run build`.
# DO NOT include private API secrets or service accounts here.
# Note: In Vite, all variables exposed to client-side code must start with VITE_.
# ==============================================================================

# Backend API Base URL
# - If using same domain or reverse proxy: /api/v1
# - If hosted on separate backend domain: https://api.lifereceipt.example.com/api/v1
# - For local development: http://localhost:5000/api/v1
VITE_API_BASE_URL=https://api.lifereceipt.example.com/api/v1

# Application Name
VITE_APP_NAME=LifeReceipt

# Public Google OAuth Client ID (Public identifier only, DO NOT put secret here)
VITE_GOOGLE_CLIENT_ID=replace_with_your_google_client_id.apps.googleusercontent.com

# Timeouts in Milliseconds
VITE_DOCUMENT_PROCESSING_TIMEOUT_MS=60000
VITE_API_TIMEOUT_MS=25000
