# ==============================================================================
# LIFERECEIPT BACKEND PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in production credentials before deploying.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# MongoDB Database Connection
# Replace with your MongoDB Atlas or managed MongoDB connection string
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/lifereceipt?retryWrites=true&w=majority

# JWT Authentication
# Generate a cryptographically secure random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_64_char_random_string_in_production
JWT_EXPIRES_IN=7d

# AES-256 Encryption Key (Used for encrypting third-party OAuth refresh tokens at rest)
# Generate a separate strong secret or random 32-byte key
TOKEN_ENCRYPTION_KEY=replace_with_a_secure_encryption_key_for_oauth_tokens

# CORS and Domains
# Comma-separated list of allowed frontend domains
CLIENT_URL=https://lifereceipt.example.com
FRONTEND_URL=https://lifereceipt.example.com
BACKEND_URL=https://api.lifereceipt.example.com

# Local File Upload Storage
# Note: In ephemeral serverless environments, configure persistent volume or object storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# AI Intelligence Providers
# Options: GEMINI (default and recommended) or OPENAI
AI_PROVIDER=GEMINI
GEMINI_API_KEY=replace_with_your_google_ai_studio_gemini_api_key
OPENAI_API_KEY=optional_openai_api_key_if_using_openai_provider

# Google OAuth 2.0 & Gmail Integration
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=replace_with_your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_your_google_client_secret
GOOGLE_REDIRECT_URI=https://lifereceipt.example.com/oauth/google/callback

# Aliases for backward compatibility
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=

# External Product Intelligence & Search (Optional)
EXTERNAL_PRODUCT_API_KEY=optional_external_product_lookup_key
SEARCH_PROVIDER_API_KEY=optional_search_provider_key

# Document Processing & AI Timeout (Milliseconds, default 60000 = 60s)
DOCUMENT_PROCESSING_TIMEOUT_MS=60000
